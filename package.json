{
  "name": "mcp-tool-explorer",
  "displayName": "MCP Tool Explorer",
  "description": "Inspect and test MCP servers: browse tools, resources, prompts, run calls, and review syntax-highlighted results and history.",
  "version": "1.13.0",
  "publisher": "jurgen178",
  "repository": {
    "type": "git",
    "url": "https://github.com/jurgen178/mcp-tool-explorer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "ai",
    "tools",
    "inspector"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "workspaceContains:.vscode/mcp.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MCP Tool Explorer",
      "properties": {
        "mcpToolExplorer.auth.accountSelection": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-server OAuth account selection behavior. Keys can be MCP server names or internal server IDs. Values: `auto` uses the current VS Code account silently when possible, `prompt` asks which account to use when OAuth is required, and `disabled` skips the automatic OAuth retry after HTTP 401.",
          "additionalProperties": {
            "type": "string",
            "enum": ["auto", "prompt", "disabled"]
          }
        }
      }
    },
    "commands": [
      {
        "command": "mcpToolExplorer.open",
        "title": "Open MCP Tool Explorer",
        "category": "MCP",
        "icon": "$(plug)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mcpToolExplorer.open"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:webview && node esbuild.config.mjs",
    "build:webview": "cd webview-ui && npm install && npm run build",
    "build:extension": "node esbuild.config.mjs",
    "watch:extension": "node esbuild.config.mjs --watch",
    "compile-check": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.27.4",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
